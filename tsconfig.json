{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],

    "module": "node16",
    "moduleResolution": "node16",

    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": ["core", "shell", "view", "tests"]
}
